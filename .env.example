# ── TaskPulse Environment Variables ──────────────────────────────────────────

# Gemini AI API Key (injected automatically by AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App URL (injected automatically by AI Studio / Cloud Run)
APP_URL="MY_APP_URL"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Leave blank to run in demo/mock mode (no database required)
MONGODB_URI="mongodb+srv://taskpulse_user:taskpulse2026@cluster0.7iorggl.mongodb.net/?appName=Cluster0"
# Example: MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/taskpulse"

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_EXPIRES_IN="7d"

# ── Optional: Cloudinary (file uploads) ──────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ── Optional: Email (OTP sending) ────────────────────────────────────────────
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# FROM_EMAIL="noreply@taskpulse.io"
